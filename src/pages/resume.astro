---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CvMatrix from '../components/recruiter/CvMatrix.astro';
import { person, education, experience, languages, leadership } from '../data/profile';
import { capabilities } from '../data/capabilities';
import { KINDS } from '../content.config';

const projects = (await getCollection('projects', (p) => !p.data.draft && p.data.kind !== 'meta')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="CV and résumé"
  description="Download the CV of Alexander Yordanov in English or German for software engineering, data engineering or engineering software roles, or read the online résumé."
>
  <div class="wrap sheet">
    <header class="r-head">
      <div>
        <p class="label no-print">CV and résumé</p>
        <h1>{person.name}</h1>
        <p class="lede">{person.positioning}</p>
      </div>
      <ul class="r-contact" role="list">
        <li>{person.location}</li>
        <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
        <li><a href={person.linkedin} rel="me noopener">linkedin.com/in/alexander-yordanov-04b242245</a></li>
        <li><a href={person.github} rel="me noopener">github.com/{person.githubHandle}</a></li>
        <li class="only-print">hyp3ralex.github.io</li>
      </ul>
    </header>

    <div class="r-actions no-print">
      <CvMatrix />
    </div>

    <section aria-labelledby="r-edu">
      <h2 id="r-edu">Education</h2>
      {
        education.map((e) => (
          <div class="row">
            <p class="mono">{e.since} — present</p>
            <div>
              <h3>{e.degree} <span class="dim">(<span lang="de">{e.degreeDe}</span>)</span></h3>
              <p>{e.institution} · {e.note.toLowerCase()}</p>
              <p class="dim small">Coursework in {e.coursework.join(', ')}</p>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="r-exp">
      <h2 id="r-exp">Experience</h2>
      {
        experience.map((x) => (
          <div class="row">
            <p class="mono">{x.period}<br />{x.duration}</p>
            <div>
              <h3>{x.org}, {x.place}</h3>
              <p>{x.role}</p>
              <ul>
                {x.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="r-lead">
      <h2 id="r-lead">Leadership</h2>
      {
        leadership.map((l) => (
          <div class="row">
            <p class="mono">{l.context.split(' · ')[1]}</p>
            <div>
              <h3>{l.title} — <a href={`/projects/${l.projectId}/`}>{l.project}</a></h3>
              <p>{l.line}</p>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="r-proj">
      <h2 id="r-proj">Projects</h2>
      {
        projects.map((p) => (
          <div class="row">
            <p class="mono">{p.data.period}</p>
            <div>
              <h3>
                <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                <span class="dim"> · {KINDS[p.data.kind]}</span>
              </h3>
              <p>{p.data.summary}</p>
              <p class="dim small">
                {p.data.role}. Stack: {p.data.stack.join(', ')}.
                {p.data.repo && <> Source: github.com/{p.data.repo}</>}
              </p>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="r-skills">
      <h2 id="r-skills">Technical focus</h2>
      {
        capabilities.map((c) => (
          <div class="row">
            <p class="mono">{c.title}</p>
            <div>
              <ul>
                {c.items.map((i) => <li>{i.text}</li>)}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="r-lang">
      <h2 id="r-lang">Languages</h2>
      <div class="row">
        <p class="mono">Spoken</p>
        <div>
          <p>{languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</p>
        </div>
      </div>
    </section>
  </div>
</Base>



<style>
  .sheet {
    max-width: 62rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--section);
  }
  .r-head {
    display: grid;
    gap: var(--s-6);
    padding-bottom: var(--s-6);
  }
  .r-head h1 {
    margin: var(--s-4) 0;
    font-size: clamp(2.5rem, 1.2rem + 6vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .r-head .lede {
    font-size: var(--text-md);
    max-width: 50ch;
  }
  .r-contact {
    display: grid;
    gap: 2px;
    font-size: var(--text-sm);
    color: var(--text-2);
    align-content: end;
  }
  .r-contact a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    overflow-wrap: anywhere;
  }
  .only-print {
    display: none;
  }
  .r-actions {
    padding-bottom: var(--s-3);
  }
  .r-actions [hidden] {
    display: none;
  }
  section {
    padding-top: var(--s-7);
  }
  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--border-strong);
  }
  .row {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }
  .row h3 {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }
  .row h3 .dim {
    font-weight: 400;
  }
  .row p {
    color: var(--text-2);
    max-width: 68ch;
  }
  .row .small {
    margin-top: var(--s-1);
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .row ul {
    margin: var(--s-2) 0 0;
    padding-left: 1.1em;
    color: var(--text-2);
  }
  .row li + li {
    margin-top: 2px;
  }
  @media (min-width: 48em) {
    .r-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .row {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--s-5);
    }
    .row > .mono {
      padding-top: 0.3em;
    }
  }
  @media print {
    .sheet {
      padding-block: 0;
      max-width: none;
    }
    .only-print {
      display: block;
    }
    .r-head {
      grid-template-columns: 1fr auto;
      padding-bottom: 0.5rem;
    }
    .r-head h1 {
      font-size: 24pt;
      margin: 0 0 4pt;
    }
    .r-head .lede {
      font-size: 10pt;
    }
    section {
      padding-top: 10pt;
    }
    .row {
      grid-template-columns: 8.5rem 1fr;
      gap: 12pt;
      padding: 5pt 0;
      font-size: 9pt;
      break-inside: avoid;
    }
    .row h3 {
      font-size: 10pt;
    }
    .row .small {
      font-size: 8pt;
    }
    .r-contact a::after,
    .row a::after {
      content: none !important;
    }
  }
</style>
