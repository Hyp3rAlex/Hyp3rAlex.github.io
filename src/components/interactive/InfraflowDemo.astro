---
/**
 * InfraFlow "mission control" demo: filter the synthetic demand register by lifecycle status and category;
 * KPIs, the status chart and the record table recalculate in the browser with src/lib/infraflow.ts.
 * The unfiltered state is rendered here at build time, so the demo is meaningful without JavaScript.
 */
import data from '../../data/demo/infraflow.json';
import {
  computeKpis,
  flagsOf,
  kpiReadout,
  priorityBand,
  priorityScore,
  sortDemands,
  statusPresets,
  summarise,
  fmtEur,
  type Demand,
  type Meta,
} from '../../lib/infraflow';

const meta = data.meta as unknown as Meta;
const demands = data.demands as unknown as Demand[];
const labels = data.meta.statusLabel as Record<string, string>;
const jira = data.meta.statusToJira as Record<string, string>;
const { values } = computeKpis(demands, meta);
const tiles = kpiReadout(values);
const rows = sortDemands(demands, 'id', 'asc', meta);
const maxCount = Math.max(...Object.values(values.by_status));
const categories = data.meta.categories.map((c) => ({ c, n: demands.filter((d) => d.category === c).length }));
const fin = data.portfolio.finance;
const ex = data.portfolio.exceptionCounts;
const eur = fmtEur;
const defs = data.expected.definitions as Record<string, string>;
const columns = [
  { key: 'id', label: 'ID' },
  { key: 'title', label: 'Demand' },
  { key: 'status', label: 'Status' },
  { key: 'category', label: 'Category' },
  { key: 'team', label: 'Team' },
  { key: 'score', label: 'Score' },
  { key: 'due', label: 'Due' },
] as const;
const presets = statusPresets(data.meta as unknown as Parameters<typeof statusPresets>[0]);
const PRIMARY = 6;
const provisional = data.portfolio.provisional;
const payload = JSON.stringify({ meta: data.meta, demands: data.demands }).replace(/</g, '\\u003c');
---

<infraflow-demo class="demo full">
  <div class="demo-bar">
    <span>InfraFlow · demand register · cutoff {meta.asOf}</span>
    <span class="badge">Synthetic data · browser re-implementation</span>
  </div>
  <p class="notice">
    Independent demonstrator for a fictional company. The {demands.length} records are the repository's bundled synthetic dataset; there is no live Jira
    connection and nothing is fetched.
  </p>

  <form class="demo-controls" aria-label="Filters">
    <fieldset class="status-field" disabled data-needs-js>
      <legend>Lifecycle status</legend>
      <div class="presets" role="group" aria-label="Status presets">
        {
          presets.map((p) => (
            <button type="button" class="btn btn--sm" data-preset={p.statuses.join(',')} data-preset-id={p.id} aria-pressed={p.id === 'all' ? 'true' : 'false'}>
              {p.label}
            </button>
          ))
        }
      </div>
      <details class="status-more">
        <summary>
          Individual statuses <span data-status-count>{meta.statusOrder.length} of {meta.statusOrder.length} selected</span>
        </summary>
        <div class="chips">
          {
            meta.statusOrder.map((s) => (
              <label class="chip">
                <input type="checkbox" name="status" value={s} checked />
                <span>{labels[s]}</span>
              </label>
            ))
          }
        </div>
      </details>
    </fieldset>
    <div class="field">
      <label for="if-category">Category</label>
      <select id="if-category" name="category" disabled data-needs-js>
        <option value="">All categories ({demands.length})</option>
        {categories.map(({ c, n }) => <option value={c}>{c} ({n})</option>)}
      </select>
    </div>
    <button type="reset" class="btn" disabled data-needs-js>Reset</button>
    <noscript><p class="nojs">Filtering and sorting need JavaScript. The unfiltered register is shown below.</p></noscript>
  </form>

  <p class="status-line" role="status" aria-live="polite" data-live>{summarise(values, demands.length)}</p>

  <div class="demo-stage">
    <div class="kpis">
      <dl class="demo-readout tiles">
        {
          tiles.slice(0, PRIMARY).map((t) => (
            <div>
              <dt>{t.label}</dt>
              <dd data-kpi={t.key}>{t.value}</dd>
            </div>
          ))
        }
      </dl>
      <details class="more-kpis" open data-collapse-small>
        <summary>All KPIs: {tiles.length - PRIMARY} more</summary>
        <dl class="demo-readout tiles">
          {
            tiles.slice(PRIMARY).map((t) => (
              <div>
                <dt>{t.label}</dt>
                <dd data-kpi={t.key}>{t.value}</dd>
              </div>
            ))
          }
        </dl>
      </details>
    </div>

    <div class="chart" aria-hidden="true">
      <p class="chart-title">Demands per lifecycle status <span>selected / all · Jira status it maps to</span></p>
      <ul role="list">
        {
          meta.statusOrder.map((s) => {
            const n = values.by_status[s] ?? 0;
            return (
              <li data-status={s} class:list={{ closed: meta.terminal.includes(s) }}>
                <span class="k">{labels[s]}</span>
                <span class="track" style={`width:${((n / maxCount) * 100).toFixed(1)}%`}>
                  <i data-bar style="width:100%" />
                </span>
                <span class="v">
                  <b data-count>{n}</b> / {n}
                </span>
                <span class="j">{jira[s]}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <details class="records" open data-collapse-small>
    <summary>Demand records: <span data-row-count>{demands.length} of {demands.length}</span> shown</summary>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Demand records matching the filter">
      <table>
        <caption class="visually-hidden">Synthetic demand records matching the current filter. Column headers sort the table.</caption>
        <thead>
          <tr>
            {
              columns.map((c) => (
                <th scope="col" aria-sort={c.key === 'id' ? 'ascending' : 'none'} class:list={{ num: c.key === 'score' }}>
                  <button type="button" data-sort={c.key} disabled data-needs-js>
                    {c.label}
                    <span class="dir" aria-hidden="true" />
                  </button>
                </th>
              ))
            }
            <th scope="col">Flags</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((d) => {
              const score = priorityScore(d.scores, meta.scoreWeights);
              const f = flagsOf(d, meta);
              const flags = [f.overdue && 'overdue', f.blocked && 'blocked', f.stale && 'stale', f.unassigned && 'no owner'].filter(Boolean);
              return (
                <tr data-id={d.id}>
                  <th scope="row" class="id">
                    {d.id.replace('ORION-', '')}
                  </th>
                  <td class="title">{d.title}</td>
                  <td>{labels[d.status]}</td>
                  <td>{d.category}</td>
                  <td>{d.team}</td>
                  <td class="num">
                    {score === null ? 'n/a' : score.toFixed(1)}
                    <span class="band">{priorityBand(score, meta.priorityBands)}</span>
                  </td>
                  <td class="date">{d.dueAt ?? 'n/a'}</td>
                  <td class="flags">{flags.length ? flags.map((x) => <span>{x}</span>) : <span class="none">none</span>}</td>
                </tr>
              );
            })
          }
          <tr class="empty" hidden>
            <td colspan="8">No demands match this filter. Reset to see all {demands.length}.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>

  <dl class="demo-readout fixed">
    <div class="fixed-head">
      <dt>Whole portfolio</dt>
      <dd>not affected by the filter</dd>
    </div>
    <div>
      <dt>Report state</dt>
      <dd>{provisional ? <span class="verdict" data-state="warn">▲ Provisional</span> : <span class="verdict" data-state="pass">✓ Final</span>}</dd>
    </div>
    <div>
      <dt>Data exceptions</dt>
      <dd>{data.portfolio.exceptions.length} <span class="sub">({ex.CRITICAL} critical)</span></dd>
    </div>
    <div>
      <dt>Forecast at completion</dt>
      <dd>{eur(fin.forecastEacEur)}</dd>
    </div>
    <div>
      <dt>Period budget</dt>
      <dd>{eur(fin.budgetEur)}</dd>
    </div>
  </dl>

  <details>
    <summary>Chart data: demands per status (selected / all)</summary>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Demands per status">
      <table>
        <thead>
          <tr><th scope="col">Lifecycle status</th><th scope="col">Jira status</th><th scope="col" class="num">Selected</th><th scope="col" class="num">All</th></tr>
        </thead>
        <tbody>
          {
            meta.statusOrder.map((s) => (
              <tr>
                <th scope="row">{labels[s]}</th>
                <td>{jira[s]}</td>
                <td class="num" data-cell={s}>{values.by_status[s]}</td>
                <td class="num">{values.by_status[s]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>

  <details>
    <summary>Exception register: {data.portfolio.exceptions.length} entries computed by the Python validator (whole portfolio)</summary>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Exception register">
      <table>
        <thead>
          <tr><th scope="col">Severity</th><th scope="col">Code</th><th scope="col">Record</th><th scope="col">Finding</th></tr>
        </thead>
        <tbody>
          {
            data.portfolio.exceptions.map((e) => (
              <tr>
                <td class="sev">{e.severity}</td>
                <td class="code">{e.code}</td>
                <td class="code">{e.record}</td>
                <td>{e.message}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>

  <details>
    <summary>KPI definitions, as worded in the repository</summary>
    <div class="table-scroll" tabindex="0" role="region" aria-label="KPI definitions">
      <table>
        <thead>
          <tr><th scope="col">Tile</th><th scope="col">Definition</th></tr>
        </thead>
        <tbody>
          {
            tiles.map((t) => (
              <tr>
                <th scope="row">{t.label}</th>
                <td>{defs[t.key]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>

  <p class="demo-foot">
    Data: synthetic dataset of <code>{data.provenance.sourceRepo.replace('github.com/', '')}</code> at revision <code>{data.provenance.sourceCommit}</code>, cutoff
    {meta.asOf}, exported {data.provenance.exportedOn}. {data.provenance.neutralised} The KPI logic is a TypeScript re-implementation of 26 of the repository's 27 portable demand KPIs (the per-site breakdown is not shipped), unit-tested
    against the repository's published report facts for all 50 demands and against audit-computed subsets. It is not the project's code running in the browser; the
    repository has no web front end. Gate results, finance and exceptions are precomputed by the Python model and shown as recorded. All dates are relative
    to the cutoff, not to today.
  </p>
  <script type="application/json" data-payload set:html={payload} />
</infraflow-demo>

<script>
  import {
    activePreset,
    barPercent,
    computeKpis,
    filterDemands,
    filterFromSelection,
    kpiReadout,
    statusPresets,
    sortDemands,
    summarise,
    type Demand,
    type Meta,
    type SortDir,
    type SortKey,
  } from '../../lib/infraflow';

  class InfraflowDemo extends HTMLElement {
    private meta!: Meta;
    private demands: Demand[] = [];
    private sortKey: SortKey = 'id';
    private sortDir: SortDir = 'asc';
    private rowsById = new Map<string, HTMLTableRowElement>();
    private form!: HTMLFormElement;

    connectedCallback(): void {
      const raw = this.querySelector('[data-payload]')?.textContent;
      const form = this.querySelector('form');
      if (!raw || !form) return;
      const parsed = JSON.parse(raw) as { meta: Meta; demands: Demand[] };
      this.meta = parsed.meta;
      this.demands = parsed.demands;
      this.form = form;
      for (const tr of this.querySelectorAll<HTMLTableRowElement>('tbody tr[data-id]')) this.rowsById.set(tr.dataset.id!, tr);

      // Controls are rendered disabled so that nothing looks operable without JavaScript.
      for (const el of this.querySelectorAll<HTMLButtonElement | HTMLSelectElement | HTMLFieldSetElement>('[data-needs-js]')) el.disabled = false;
      // Everything is open by default; on phones the secondary KPIs and the table start collapsed.
      if (window.matchMedia('(max-width: 40em)').matches)
        for (const d of this.querySelectorAll<HTMLDetailsElement>('[data-collapse-small]')) d.open = false;

      form.addEventListener('change', () => this.update());
      form.addEventListener('submit', (e) => e.preventDefault());
      form.addEventListener('reset', () => {
        this.sortKey = 'id';
        this.sortDir = 'asc';
        // The form controls are restored after the reset event has been dispatched.
        setTimeout(() => this.update(), 0);
      });
      for (const b of this.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
        b.addEventListener('click', () => {
          const want = new Set(b.dataset.preset!.split(','));
          for (const c of this.statusBoxes()) c.checked = want.has(c.value);
          this.update();
        });
      }
      for (const b of this.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
        b.addEventListener('click', () => {
          const key = b.dataset.sort as SortKey;
          this.sortDir = this.sortKey === key && this.sortDir === 'asc' ? 'desc' : 'asc';
          this.sortKey = key;
          this.update(false);
        });
      }
    }

    private statusBoxes(): HTMLInputElement[] {
      return [...this.form.querySelectorAll<HTMLInputElement>('input[name="status"]')];
    }

    private update(announce = true): void {
      const boxes = this.statusBoxes();
      const checked = boxes.filter((b) => b.checked).map((b) => b.value);
      const category = this.form.querySelector<HTMLSelectElement>('select[name="category"]')!.value;
      const selected = filterDemands(this.demands, filterFromSelection(checked, boxes.length, category));
      const { values } = computeKpis(selected, this.meta);

      const active = activePreset(checked, statusPresets(this.meta as Parameters<typeof statusPresets>[0]));
      for (const b of this.querySelectorAll<HTMLButtonElement>('[data-preset]')) b.setAttribute('aria-pressed', String(b.dataset.presetId === active));
      const rowCount = this.querySelector('[data-row-count]');
      if (rowCount) rowCount.textContent = `${selected.length} of ${this.demands.length}`;
      const count = this.querySelector('[data-status-count]');
      if (count) count.textContent = `${checked.length} of ${boxes.length} selected`;

      for (const t of kpiReadout(values)) {
        const el = this.querySelector(`[data-kpi="${t.key}"]`);
        if (el) el.textContent = t.value;
      }

      // Chart: the outlined track is the full-set count, the filled bar the selected count.
      const all = computeKpis(this.demands, this.meta).values.by_status;
      for (const li of this.querySelectorAll<HTMLLIElement>('.chart li[data-status]')) {
        const s = li.dataset.status!;
        const n = values.by_status[s] ?? 0;
        const total = all[s] ?? 0;
        li.querySelector<HTMLElement>('[data-bar]')!.style.width = `${barPercent(n, total)}%`;
        li.querySelector('[data-count]')!.textContent = String(n);
        li.classList.toggle('off', n === 0);
        const cell = this.querySelector(`[data-cell="${s}"]`);
        if (cell) cell.textContent = String(n);
      }

      // Table: rows are server-rendered once; filtering hides them, sorting reorders them.
      const tbody = this.querySelector('.records tbody')!;
      const empty = tbody.querySelector<HTMLTableRowElement>('.empty')!;
      const visible = new Set(selected.map((d) => d.id));
      for (const d of sortDemands(this.demands, this.sortKey, this.sortDir, this.meta)) {
        const tr = this.rowsById.get(d.id);
        if (!tr) continue;
        tr.hidden = !visible.has(d.id);
        tbody.insertBefore(tr, empty);
      }
      empty.hidden = selected.length > 0;
      for (const b of this.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
        const active = b.dataset.sort === this.sortKey;
        b.closest('th')!.setAttribute('aria-sort', active ? (this.sortDir === 'asc' ? 'ascending' : 'descending') : 'none');
      }

      if (announce) this.querySelector('[data-live]')!.textContent = summarise(values, this.demands.length);
    }
  }

  if (!customElements.get('infraflow-demo')) customElements.define('infraflow-demo', InfraflowDemo);
</script>

<style>
  infraflow-demo {
    display: block;
  }
  .notice,
  .status-line {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-2);
    max-width: none;
  }
  .status-line {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text);
  }
  .status-field {
    flex: 1 1 100%;
  }
  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block: var(--s-2) var(--s-3);
  }
  .presets .btn {
    min-height: 2.75rem;
  }
  .presets .btn[aria-pressed='true'] {
    --btn-bg: var(--accent);
    --btn-fg: var(--accent-ink);
    --btn-bd: var(--accent);
  }
  .demo .status-more {
    border: 1px solid var(--border);
    border-radius: var(--r-2);
  }
  .demo .status-more > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    padding: var(--s-2) var(--s-3);
  }
  .status-more summary span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .status-more .chips {
    padding: 0 var(--s-3) var(--s-3);
  }
  .chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--s-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--border);
    border-radius: var(--r-2);
    font-size: var(--text-sm);
    color: var(--text-2);
    cursor: pointer;
    line-height: 1.25;
  }
  .chip:has(:checked) {
    border-color: var(--border-strong);
    background: var(--raised);
    color: var(--text);
  }
  .chip:has(:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .chip input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--accent);
  }
  .chip input:focus-visible {
    outline: none;
  }
  select {
    min-height: 2.75rem;
    max-width: 100%;
  }
  .nojs {
    flex-basis: 100%;
    font-size: var(--text-sm);
    color: var(--warn);
  }

  .demo-stage {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: minmax(0, 1fr);
  }
  .chart-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--s-3);
    margin-bottom: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .chart-title span {
    color: var(--text-3);
  }
  .chart ul {
    padding: 0;
    display: grid;
    gap: 5px;
  }
  .chart li {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr) 4.2em;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-2);
  }
  .chart .track {
    display: block;
    height: 14px;
    min-width: 3px;
    border: 1px solid var(--border-strong);
  }
  .chart .track i {
    display: block;
    height: 100%;
    background: var(--text-2);
    transition: width var(--t-component) var(--ease-out);
  }
  .chart li.closed .track i {
    background: var(--text-3);
  }
  .chart li.off {
    color: var(--text-3);
  }
  .chart .v {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .chart .v b {
    color: var(--text);
    font-weight: 500;
  }
  .chart .j {
    display: none;
    color: var(--text-3);
    white-space: nowrap;
  }
  .kpis {
    align-self: start;
    min-width: 0;
    border: 1px solid var(--border);
  }
  .demo .more-kpis > summary,
  .demo .records > summary {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-2);
  }
  .more-kpis .tiles {
    border-top: 1px solid var(--border);
  }
  [data-needs-js]:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .tiles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
  }
  .tiles > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 2px;
  }
  .tiles dt {
    line-height: 1.4;
  }
  .tiles dd {
    font-size: var(--text-lg);
    line-height: 1.2;
  }
  @media (min-width: 40em) {
    .chart li {
      grid-template-columns: 11em minmax(0, 1fr) 4.2em 6.5em;
    }
    .chart .j {
      display: block;
    }
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 72em) {
    .demo-stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .records .table-scroll {
    max-height: min(26rem, 60vh);
    overflow: auto;
    border: 0;
    border-radius: 0;
  }
  .records thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0;
    background: var(--raised);
    box-shadow: 0 1px 0 var(--border);
  }
  .records thead th:last-child {
    padding: var(--s-3) var(--s-4);
  }
  .records thead button {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    min-height: 2.75rem;
    padding: 0 var(--s-4);
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text-2);
    white-space: nowrap;
  }
  .records th.num button {
    justify-content: flex-end;
  }
  .records thead button:hover {
    color: var(--text);
  }
  .records thead button:focus-visible {
    outline-offset: -3px;
  }
  .dir::before {
    content: '↕';
    color: var(--text-3);
  }
  th[aria-sort='ascending'] .dir::before {
    content: '↑';
    color: var(--text);
  }
  th[aria-sort='descending'] .dir::before {
    content: '↓';
