<script>
  import { checksHtml, guardDecide, outcomeHtml, outcomeSummary, type Delegate, type GuardCase, type SupplierStatus, type Terms, type ThreadState } from '../../lib/tacto';

  interface SandboxConfig extends GuardCase {
    supplierId: string;
    supplierSheets: Record<string, { opening: Terms; standing: Terms }>;
  }

  class TactoDemo extends HTMLElement {
    private step = 1;
    private total = 1;
    private timer: number | undefined;
    private config!: SandboxConfig;

    connectedCallback() {
      this.total = Number(this.dataset.steps ?? 1);
      this.config = JSON.parse(this.dataset.case ?? '{}') as SandboxConfig;
      const range = this.q<HTMLInputElement>('#tq-step');
      range.addEventListener('input', () => {
        this.stop();
        this.go(Number(range.value));
      });
      this.addEventListener('click', (ev) => {
        const act = (ev.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
        if (act === 'prev') this.go(this.step - 1);
        else if (act === 'next') this.go(this.step + 1);
        else if (act === 'reset') this.go(1);
        else if (act === 'play') this.togglePlay();
        else if (act === 'reset-guard') this.resetGuard();
        if (act && act !== 'play') this.stop();
      });
      // Auto-play is offered only when the visitor has not asked for reduced motion.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) this.q<HTMLElement>('[data-act="play"]').hidden = false;
      this.querySelectorAll<HTMLElement>('[data-in]').forEach((el) => {
        el.addEventListener('input', () => this.runGuard());
        el.addEventListener('change', () => this.runGuard());
      });
      // Controls are rendered disabled so they are never dead without JavaScript.
      this.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement>('[data-js]').forEach((el) => (el.disabled = false));
      this.go(1, false);
    }

    disconnectedCallback() {
      this.stop();
    }

    private q<T extends Element>(sel: string): T {
      return this.querySelector<T>(sel)!;
    }
    private out(name: string): HTMLElement {
      return this.q<HTMLElement>(`[data-out="${name}"]`);
    }

    private go(n: number, announce = true) {
      this.step = Math.min(this.total, Math.max(1, n));
      let card: HTMLElement | undefined;
      this.querySelectorAll<HTMLElement>('.tq-step').forEach((el) => {
        const on = Number(el.dataset.step) === this.step;
        el.hidden = !on;
        if (on) card = el;
      });
      this.querySelectorAll<HTMLElement>('.tq-plot [data-step]').forEach((el) => {
        const s = Number(el.dataset.step);
        el.classList.toggle('is-future', s > this.step);
        el.classList.toggle('is-current', s === this.step && !el.classList.contains('tq-acclabel'));
      });
      this.q<HTMLInputElement>('#tq-step').value = String(this.step);
      this.out('stepno').textContent = String(this.step);
      this.q<HTMLButtonElement>('[data-act="prev"]').disabled = this.step <= 1;
      this.q<HTMLButtonElement>('[data-act="next"]').disabled = this.step >= this.total;
      if (card) {
        for (const k of ['round', 'sup', 'buy', 'gap', 'score']) this.out(k).textContent = card.dataset[k] ?? '';
        if (announce) this.out('say').textContent = card.dataset.say ?? '';
      }
      if (this.step >= this.total) this.stop();
    }

    private togglePlay() {
      if (this.timer !== undefined) return this.stop();
      if (this.step >= this.total) this.go(1);
      this.q<HTMLElement>('[data-act="play"]').setAttribute('aria-pressed', 'true');
      this.timer = window.setInterval(() => this.go(this.step + 1), 1400);
    }

    private stop() {
      if (this.timer !== undefined) window.clearInterval(this.timer);
      this.timer = undefined;
      const play = this.q<HTMLElement>('[data-act="play"]');
      play.setAttribute('aria-pressed', 'false');
    }

    private val(name: string): string {
      return this.q<HTMLInputElement | HTMLSelectElement>(`[data-in="${name}"]`).value;
    }

    private resetGuard() {
      this.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-in]').forEach((el) => {
        if (el instanceof HTMLSelectElement) {
          Array.from(el.options).forEach((o) => (o.selected = o.defaultSelected));
        } else el.value = el.defaultValue;
      });
      this.runGuard();
    }

    private runGuard() {
      const c = this.config;
      const kind = this.val('delegate');
      const num = (name: string): number | null => {
        const v = Number(this.val(name));
        return this.val(name).trim() === '' || Number.isNaN(v) ? null : v;
      };
      const draft: Terms = {
        unit_price: num('unit_price'),
        lead_time_days: num('lead_time_days'),
        payment_days: num('payment_days'),
        defect_ppm: num('defect_ppm'),
      };
      const isDraft = kind === 'counter';
      const problems: string[] = [];
      for (const [name, label, unit] of [
        ['unit_price', 'Unit price', 'EUR'],
        ['lead_time_days', 'Lead time', 'days'],
      ] as const) {
        const el = this.q<HTMLInputElement>(`[data-in="${name}"]`);
        const v = num(name);
        const bad = isDraft && (v === null || v < Number(el.min) || v > Number(el.max) || (name === 'lead_time_days' && !Number.isInteger(v)));
        if (bad) {
          el.setAttribute('aria-invalid', 'true');
          problems.push(`${label} must be ${name === 'lead_time_days' ? 'a whole number ' : ''}between ${el.min} and ${el.max} ${unit}.`);
        } else el.removeAttribute('aria-invalid');
      }
      this.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-draft]').forEach((el) => (el.disabled = !isDraft));
      this.out('guarderr').textContent = problems.length > 0 ? `${problems.join(' ')} The result below still shows the last valid draft.` : '';
      if (problems.length > 0) return;
      const sheet = c.supplierSheets[this.val('supplierSheet')]!;
      const thread: ThreadState = {
        supplierId: c.supplierId,
        opening: sheet.opening,
        standing: sheet.standing,
        standingId: 'offer:SYN-s',
        status: this.val('status') as SupplierStatus,
        buyerMessagesSent: c.roundLimit - Number(this.val('movesLeft')),
        guardCountersUsed: Number(this.val('guardCountersUsed')),
      };
      const delegate: Delegate =
        kind === 'counter' ? { type: 'counter', sheets: [draft] } : kind === 'accept' ? { type: 'accept', termSheetId: 'offer:SYN-s' } : kind === 'crash' ? { type: 'crash' } : { type: 'walk_away' };
      const outcome = guardDecide(c, thread, delegate);
      this.out('checktitle').textContent = isDraft ? 'Draft sheet against the must-haves' : 'Supplier’s standing sheet against the must-haves';
      this.out('checks').innerHTML = checksHtml(c, isDraft ? draft : sheet.standing, isDraft ? 'draft' : 'standing sheet');
      this.out('outcome').innerHTML = outcomeHtml(c, outcome, isDraft ? [draft] : []);
      this.out('guardsay').textContent = outcomeSummary(outcome);
    }
  }

  if (!customElements.get('tacto-demo')) customElements.define('tacto-demo', TactoDemo);
</script>
