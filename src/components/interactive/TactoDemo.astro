---
/**
 * Tacto Negotiation Arena demo: (a) step-through replay of the S01 simulator re-run, (b) guard sandbox on a
 * synthetic case. Logic: src/lib/tacto.ts. Data: src/data/demo/tacto.json.
 * Every replay step and the sandbox's default state are server-rendered; JavaScript only switches the
 * visible step and re-runs the guard re-implementation when a control changes.
 */
import data from '../../data/demo/tacto.json';
import {
  CHECK_LABELS,
  FIELD_LABELS,
  TAG_LABELS,
  acceptPoint,
  checksHtml,
  guardDecide,
  outcomeHtml,
  outcomeSummary,
  priceSeries,
  stateAt,
  type GuardCase,
  type ReplayEvent,
  type ReplayRun,
  type ThreadState,
} from '../../lib/tacto';

const run = data.run as unknown as ReplayRun;
const events = run.events;
const N = events.length;
const pts = priceSeries(run);
const sup = pts.filter((p) => p.actor === 'supplier');
const buy = pts.filter((p) => p.actor === 'buyer');
const acc = acceptPoint(run)!;
const rounds = Math.max(...pts.map((p) => p.round));
const LO = 13.5;
const HI = 18;
const x = (r: number) => 4 + (r / rounds) * 80;
const y = (p: number) => ((HI - p) / (HI - LO)) * 100;
const line = (s: typeof pts) => s.map((p) => `${x(p.round).toFixed(2)},${y(p.price).toFixed(2)}`).join(' ');
const current = data.run.buyer.current_unit_price;
const stdPay = data.run.standardTerms.payment_days;

const money = (n: number | null) => (n === null ? 'n/a' : n.toLocaleString('en-GB', { maximumFractionDigits: 0 }));
const price = (n: number | null) => (n === null ? '–' : n.toFixed(2));
const DECISIONS: Record<string, string> = { counter: 'counter-offer', accept: 'accept', walk_away: 'walk away', message: 'text-only message' };
const STATUS: Record<string, string> = { open: 'open', final_offer: 'final offer', agreed: 'agreed', walked_away: 'walked away' };
const who = (e: ReplayEvent) => (e.actor === 'supplier' ? 'Supplier' : 'Buyer agent');
const action = (e: ReplayEvent) => (e.actor === 'supplier' ? `status: ${STATUS[e.status ?? ''] ?? e.status}` : (DECISIONS[e.decision ?? ''] ?? e.decision));
const say = (e: ReplayEvent) => {
  const p = e.termSheets[0]?.terms.unit_price;
  if (e.actor === 'supplier') return `Step ${e.step} of ${N}, round ${e.round}: supplier quotes ${price(p as number)}, status ${STATUS[e.status ?? '']}.`;
  if (e.decision === 'accept') return `Step ${e.step} of ${N}, round ${e.round}: buyer agent accepts the standing sheet at ${price(acc.price)}. Deal.`;
  return `Step ${e.step} of ${N}, round ${e.round}: buyer agent sends a counter-offer at ${price(p as number)}.`;
};
const first = stateAt(run, 1);

/* ---- sandbox default state ---- */
const g = data.guardCase;
const gc = g as unknown as GuardCase;
const d = g.defaults;
const sheetKey = d.supplierSheet as keyof typeof g.supplierSheets;
const thread: ThreadState = {
  supplierId: g.supplierId,
  opening: g.supplierSheets[sheetKey].opening,
  standing: g.supplierSheets[sheetKey].standing,
  standingId: 'offer:SYN-s',
  status: 'open',
  buyerMessagesSent: g.roundLimit - d.movesLeft,
  guardCountersUsed: d.guardCountersUsed,
};
const outcome = guardDecide(gc, thread, { type: 'counter', sheets: [d.draft] });
const sandboxConfig = JSON.stringify(g);
const OPS: Record<string, string> = { '<=': 'at most', '>=': 'at least' };
const UNIT: Record<string, string> = { lead_time_days: 'days', payment_days: 'days', defect_ppm: 'ppm' };
const mustText = g.mustHaves.map((m) => `${FIELD_LABELS[m.field]?.toLowerCase() ?? m.field} ${OPS[m.op] ?? m.op} ${m.value} ${UNIT[m.field] ?? ''}`.trim());
---

<tacto-demo class="demo" data-steps={N} data-case={sandboxConfig}>
  <div class="demo-bar">
    <span>Negotiation replay and guard sandbox</span>
    <span class="tq-badges"><span class="badge">Simulator re-run</span> <span class="badge">Synthetic case</span></span>
  </div>
  <p class="tq-disclaimer">
    Not a recording from the hackathon arena. Part A replays an offline re-run against the starter kit’s scripted supplier; part B runs a browser re-implementation
    of the guard on an invented case. Scores are simulator scores, not performance claims.
  </p>

  <section aria-labelledby="tq-a">
    <h3 class="tq-h" id="tq-a"><span class="mono">A</span> <span>Replay: sample case S01, my <code>final</code> agent against the scripted supplier</span></h3>
    <p class="tq-case">
      A real run of the agent, recorded for this page. The sample case has no must-haves, so every check in this replay is valid; part B opens on a draft that breaks
      three.
    </p>
    <div class="demo-controls">
      <div class="tq-btns">
        <button type="button" class="btn" data-act="prev" disabled>← Prev</button>
        <button type="button" class="btn" data-act="next" data-js disabled>Next →</button>
        <button type="button" class="btn" data-act="play" aria-pressed="false" hidden>Play replay</button>
        <button type="button" class="btn btn--ghost" data-act="reset" data-js disabled>Reset replay</button>
      </div>
      <div class="field tq-range">
        <label for="tq-step">Step <output data-out="stepno">1</output> of {N}</label>
        <input id="tq-step" type="range" min="1" max={N} step="1" value="1" data-js disabled />
      </div>
    </div>

    <div class="demo-stage tq-stage">
      <div class="tq-chart">
        <p class="tq-legend" aria-hidden="true">
          <span><i class="tq-pt tq-pt-s"></i> supplier (square, dashed line)</span>
          <span><i class="tq-pt tq-pt-b"></i> buyer agent (circle, solid line)</span>
          <span><i class="tq-pt tq-acc"></i> accept</span>
        </p>
        <div
          class="tq-plot"
          role="img"
          aria-label={`Unit price per round. Supplier: ${sup.map((p) => p.price.toFixed(2)).join(', ')}. Buyer agent: ${buy.map((p) => p.price.toFixed(2)).join(', ')}. Accept at ${acc.price.toFixed(2)} in round ${acc.round}. The table below the chart lists every step.`}
        >
          {
            [14, 15, 16, 17, 18].map((v) => (
              <span class="tq-ytick" style={`top:${y(v)}%`}>
                {v}
              </span>
            ))
          }
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">
            {[14, 15, 16, 17].map((v) => <line class="tq-grid" x1="0" x2="100" y1={y(v)} y2={y(v)} />)}
            <line class="tq-ref" x1="0" x2="100" y1={y(current)} y2={y(current)}></line>
            <polyline class="tq-ln tq-ln-s" points={line(sup)}></polyline>
            <polyline class="tq-ln tq-ln-b" points={line(buy)}></polyline>
          </svg>
          <span class="tq-reflabel" style={`top:${y(current)}%`}>price paid today {current.toFixed(2)}</span>
          {sup.map((p) => <i class="tq-pt tq-pt-s" data-step={p.step} style={`left:${x(p.round)}%;top:${y(p.price)}%`} />)}
          {buy.map((p) => <i class="tq-pt tq-pt-b" data-step={p.step} style={`left:${x(p.round)}%;top:${y(p.price)}%`} />)}
          <i class="tq-pt tq-acc" data-step={acc.step} style={`left:${x(acc.round)}%;top:${y(acc.price)}%`}></i>
          <span class="tq-acclabel" data-step={acc.step} style={`left:${x(acc.round)}%;top:${y(acc.price)}%`}>accept<br />{acc.price.toFixed(2)}</span>
          {
            Array.from({ length: rounds + 1 }, (_, r) => (
              <span class="tq-xtick" style={`left:${x(r)}%`}>
                {r}
              </span>
            ))
          }
        </div>
        <p class="tq-axis" aria-hidden="true">round · unit price in EUR</p>
      </div>

      <div class="tq-steps">
        {
          events.map((e) => {
            const st = stateAt(run, e.step);
            return (
              <article
                class="tq-step"
                data-step={e.step}
                data-say={say(e)}
                data-round={st.round}
                data-sup={price(st.supplierPrice)}
                data-buy={price(st.buyerPrice)}
                data-gap={price(st.gap)}
                data-score={st.standingScore === null ? '–' : st.standingScore.toFixed(2)}
                hidden={e.step !== 1}
              >
                <p class="tq-stephead">
                  <span class="mono">
                    Step {e.step}/{N} · round {e.round}
                  </span>
                  <span class="tag tag--solid" data-actor={e.actor}>
                    {who(e)}
                  </span>
                </p>
                <p class="tq-action">
                  {e.actor === 'supplier' ? 'Supplier status' : 'Decision'}: <strong>{e.actor === 'supplier' ? STATUS[e.status ?? ''] : DECISIONS[e.decision ?? '']}</strong>
                  {e.decision === 'accept' && (
                    <>
                      {' '}
                      of sheet <code>{e.acceptedTermSheetId}</code> at {price(acc.price)} EUR
                    </>
                  )}
                </p>
                {e.text && <p class="tq-msg">“{e.text}”</p>}
                {e.termSheets.map((s, i) => (
                  <div class="tq-sheetbox">
                    <p class="mono">
                      {e.actor === 'supplier' ? `Term sheet ${s.termSheetId}` : `Proposed sheet ${i + 1} of ${e.termSheets.length}`}
                    </p>
                    <dl>
                      <div>
                        <dt>Unit price</dt>
                        <dd>{price(s.terms.unit_price as number)} EUR</dd>
                      </div>
                      <div>
                        <dt>Payment term</dt>
                        <dd>{s.terms.payment_days ?? stdPay} days{s.terms.payment_days === undefined && <span class="tq-dim"> (supplier standard)</span>}</dd>
                      </div>
                      <div>
                        <dt>Total cost C</dt>
                        <dd>{money(s.costEur)} EUR</dd>
                      </div>
                      <div>
                        <dt>Score if accepted</dt>
                        <dd>{e.actor === 'supplier' && s.scoreIfAccepted !== null ? s.scoreIfAccepted.toFixed(2) : <span class="tq-dim">n/a (own proposal)</span>}</dd>
                      </div>
                    </dl>
                    <ul class="tq-checks" role="list">
                      {s.checks.map((c) => (
                        <li>
                          <span class="verdict" data-state={c.ok ? 'pass' : 'fail'}>
                            <span aria-hidden="true">{c.ok ? '✓' : '✕'}</span> {c.ok ? 'valid' : 'invalid'}
                          </span>{' '}
                          {CHECK_LABELS[c.check] ?? c.check}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                {e.actor === 'buyer' && (
                  <div class="tq-why">
                    <p class="mono">Why (annotation, derived after the run)</p>
                    <ul class="tags">
                      {(e.rationale ?? []).map((t) => (
                        <li class="tag" data-source={t.source}>
                          {TAG_LABELS[t.tag] ?? t.tag}
                        </li>
                      ))}
                    </ul>
                    <p class="mono tq-guardline">
                      Guard log: {(e.guardLog ?? []).length > 0 ? (e.guardLog ?? []).join(' · ') : 'no line emitted, decision passed through unchanged'}
                    </p>
                  </div>
                )}
                {e.actor === 'supplier' && e.step === 1 && (
                  <p class="tq-note">The simulator’s supplier is a fixed script: it opens 10% above the current price and concedes 2% of its opening per message, with a final offer in round 5.</p>
                )}
              </article>
            );
          })
        }
      </div>
    </div>

    <dl class="demo-readout">
      <div>
        <dt>Round</dt>
        <dd data-out="round">{first.round}</dd>
      </div>
      <div>
        <dt>Supplier price, EUR</dt>
        <dd data-out="sup">{price(first.supplierPrice)}</dd>
      </div>
      <div>
        <dt>Buyer price, EUR</dt>
        <dd data-out="buy">{price(first.buyerPrice)}</dd>
      </div>
      <div>
        <dt>Gap, EUR</dt>
        <dd data-out="gap">{price(first.gap)}</dd>
      </div>
      <div>
        <dt>Simulator score of standing sheet</dt>
        <dd data-out="score">{first.standingScore?.toFixed(2)}</dd>
      </div>
    </dl>
    <p class="tq-status" role="status" data-out="say">{say(events[0]!)}</p>

    <details>
      <summary>All {N} steps as a table</summary>
      <div class="table-scroll" tabindex="0" role="group" aria-label="Replay steps">
        <table>
          <thead>
            <tr>
              <th>Step</th>
              <th>Round</th>
              <th>Actor</th>
              <th>Action</th>
              <th class="num">Unit price</th>
              <th class="num">Payment days</th>
              <th class="num">Total cost C</th>
              <th class="num">Score if accepted</th>
            </tr>
          </thead>
          <tbody>
            {
              events.flatMap((e) =>
                (e.termSheets.length > 0 ? e.termSheets : [null]).map((s) => (
                  <tr>
                    <td>{e.step}</td>
                    <td>{e.round}</td>
                    <td>{who(e)}</td>
                    <td>{action(e)}</td>
                    <td class="num">{s ? price(s.terms.unit_price as number) : price(acc.price)}</td>
                    <td class="num">{s ? (s.terms.payment_days ?? `${stdPay}*`) : `${stdPay}*`}</td>
                    <td class="num">{s ? money(s.costEur) : money(acc.sheet.costEur)}</td>
                    <td class="num">{s && e.actor === 'supplier' ? s.scoreIfAccepted?.toFixed(2) : s ? '–' : run.result.score.toFixed(2)}</td>
                  </tr>
                )),
              )
            }
          </tbody>
        </table>
      </div>
      <p class="tq-tablenote">* supplier’s standard payment term, read from its quote. Score = (C_open − C) / (C_open − C_best) with the simulator’s own C_open and C_best.</p>
    </details>
  </section>

  <section aria-labelledby="tq-b" class="tq-sandbox">
    <h3 class="tq-h" id="tq-b"><span class="mono">B</span> <span>Guard sandbox: what the guard does with a delegate’s decision</span></h3>
    <p class="tq-case">
      <span class="tag">Synthetic case</span> One supplier, a machined bracket. Must-haves: {mustText.join('; ')}. The buyer’s alternative costs {g.alternative.unit_price.toFixed(2)} EUR per unit. The
      starting draft below breaks all three must-haves; the right-hand panel shows what the guard sends instead.
    </p>
    <div class="demo-controls tq-form">
      <fieldset>
        <legend>Delegate agent’s decision</legend>
        <div class="tq-fields">
          <div class="field">
            <label for="tq-del">Decision</label>
            <select id="tq-del" data-js disabled data-in="delegate">
              <option value="counter" selected>Counter-offer (draft sheet)</option>
              <option value="accept">Accept the standing sheet</option>
              <option value="walk_away">Walk away</option>
              <option value="crash">Crash (exception)</option>
            </select>
          </div>
          <div class="field">
            <label for="tq-price">Unit price, EUR</label>
            <input id="tq-price" data-js disabled data-in="unit_price" data-draft type="number" min="15" max="30" step="0.05" value={d.draft.unit_price} inputmode="decimal" aria-describedby="tq-price-hint" />
            <small class="tq-hint" id="tq-price-hint">15.00 to 30.00 EUR</small>
          </div>
          <div class="field">
            <label for="tq-lead">Lead time, days</label>
            <input id="tq-lead" data-js disabled data-in="lead_time_days" data-draft type="number" min="14" max="60" step="1" value={d.draft.lead_time_days} inputmode="numeric" aria-describedby="tq-lead-hint" />
            <small class="tq-hint" id="tq-lead-hint">14 to 60 days, whole days</small>
          </div>
          <div class="field">
            <label for="tq-pay">Payment term, days</label>
            <select id="tq-pay" data-js disabled data-in="payment_days" data-draft>
              {g.termOptions.payment_days.map((o) => <option value={o} selected={o === d.draft.payment_days}>{o}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="tq-ppm">Defect rate, ppm</label>
            <select id="tq-ppm" data-js disabled data-in="defect_ppm" data-draft>
              {g.termOptions.defect_ppm.map((o) => <option value={o} selected={o === d.draft.defect_ppm}>{o}</option>)}
            </select>
          </div>
        </div>
      </fieldset>
      <fieldset>
        <legend>Thread state</legend>
        <div class="tq-fields">
          <div class="field">
            <label for="tq-sup">Supplier’s standing sheet</label>
            <select id="tq-sup" data-js disabled data-in="supplierSheet">
              {
                Object.entries(g.supplierSheets).map(([k, v]) => (
                  <option value={k} selected={k === d.supplierSheet}>
                    {v.label} ({v.standing.unit_price.toFixed(2)})
                  </option>
                ))
              }
            </select>
          </div>
          <div class="field">
            <label for="tq-status">Supplier status</label>
            <select id="tq-status" data-js disabled data-in="status">
              <option value="open" selected>open</option>
              <option value="final_offer">final offer</option>
            </select>
          </div>
          <div class="field">
            <label for="tq-left">Our messages left</label>
            <select id="tq-left" data-js disabled data-in="movesLeft">
              <option value="10">10 (we have not written yet)</option>
              <option value="6" selected>6</option>
              <option value="1">1 (last message)</option>
              <option value="0">0</option>
            </select>
          </div>
          <div class="field">
            <label for="tq-used">Guard counters already sent</label>
            <select id="tq-used" data-js disabled data-in="guardCountersUsed">
              <option value="0" selected>0</option>
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </div>
          <button type="button" class="btn btn--ghost" data-act="reset-guard" data-js disabled>Reset sandbox</button>
        </div>
      </fieldset>
    </div>
    <p class="tq-err" role="status" data-out="guarderr"></p>
    <div class="demo-stage tq-guard">
      <div>
        <p class="mono" data-out="checktitle">Draft sheet against the must-haves</p>
        <ul class="tq-mh" role="list" data-out="checks" set:html={checksHtml(gc, d.draft)} />
        <p class="tq-note">Lead time is free text here on purpose: the arena only allows {g.termOptions.lead_time_days.join(', ')} days, and the kit snaps a value to the nearest option before it is sent.</p>
      </div>
      <div>
        <p class="mono">What the guard returns</p>
        <div class="tq-outcome" data-out="outcome" set:html={outcomeHtml(gc, outcome, [d.draft])} />
      </div>
    </div>
    <p class="visually-hidden" role="status" data-out="guardsay">{outcomeSummary(outcome)}</p>
  </section>

  <p class="demo-foot">
    Part A: deterministic offline re-run of the repository’s <code>final</code> agent chain against the starter kit’s local simulator on its sample case S01, recorded
    for this page on 25 Nov 2026 at revision <code>{data.provenance.replay.sourceCommit}</code>; costs, checks and scores were computed by the repository’s own
    functions. “Why” tags are annotations added afterwards; the guard logged nothing in this run. Part B: TypeScript re-implementation of the rules in
    <code>agent/arena_kit/guard.py</code> for a single thread, with a simplified two-term cost model, on a hand-written synthetic case. Log lines use the wording of
    <code>guard.py</code>, and the port is tested against outputs of the original Python on the same synthetic inputs. The starter kit, including case S01 and its simulator, is stated by the repository to be MIT-licensed. No network requests.
  </p>
</tacto-demo>

<style is:global>
  tacto-demo {
    display: block;
  }
  tacto-demo .tq-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  tacto-demo .tq-disclaimer {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-2);
  }
  tacto-demo .tq-h {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    margin: 0;
    padding: var(--s-4) var(--s-4) var(--s-3);
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  tacto-demo .tq-h .mono {
    flex: none;
    padding: 0 0.45em;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-1);
    color: var(--text);
  }
  tacto-demo .tq-sandbox {
    border-top: 1px solid var(--border-strong);
  }
  tacto-demo .tq-btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  tacto-demo .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  tacto-demo .btn[aria-pressed='true'] {
    --btn-bg: var(--raised);
    --btn-bd: var(--text);
  }
  tacto-demo .tq-range {
    flex: 1 1 14rem;
  }
  tacto-demo .tq-range output {
    color: var(--text);
  }
  tacto-demo .tq-stage {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 60em) {
    tacto-demo .tq-stage {
      grid-template-columns: minmax(0, 11fr) minmax(0, 10fr);
    }
  }
  tacto-demo .tq-chart {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
  }
  tacto-demo .tq-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    color: var(--text-2);
  }
  tacto-demo .tq-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  tacto-demo .tq-legend .tq-pt {
    position: static;
    transform: none;
  }
  tacto-demo .tq-plot {
    position: relative;
    height: clamp(11.5rem, 42vw, 19rem);
    margin: var(--s-4) 0 1.6rem 2rem;
    border-left: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }
  tacto-demo .tq-plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  tacto-demo .tq-grid {
    stroke: var(--grid-line);
    vector-effect: non-scaling-stroke;
  }
  tacto-demo .tq-ref {
    stroke: var(--text-3);
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }
  tacto-demo .tq-ln {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  tacto-demo .tq-ln-s {
    stroke: var(--info);
    stroke-dasharray: 5 3;
  }
  tacto-demo .tq-ln-b {
    stroke: var(--text);
  }
  tacto-demo .tq-pt {
    position: absolute;
    display: inline-block;
