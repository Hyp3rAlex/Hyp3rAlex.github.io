---
/**
 * Card / hero visual: the service's real output as a US tile-grid map.
 * One square per state in a schematic grid defined below (row/column coordinates, no map asset), shaded in five
 * monochrome population steps from the state-level snapshot. Connecticut is drawn as the "null → skipped" tile.
 * A side column shows the ingest-to-API flow when the container is wide enough.
 */
import data from '../../../data/demo/demographics.json';

/** Schematic tile grid, 12 columns × 8 rows: abbr → [column, row]. */
const GRID: Record<string, [number, number]> = {
  AK: [0, 0], ME: [11, 0],
  VT: [10, 1], NH: [11, 1],
  WA: [1, 2], ID: [2, 2], MT: [3, 2], ND: [4, 2], MN: [5, 2], IL: [6, 2], WI: [7, 2], MI: [8, 2], NY: [9, 2], RI: [10, 2], MA: [11, 2],
  OR: [1, 3], NV: [2, 3], WY: [3, 3], SD: [4, 3], IA: [5, 3], IN: [6, 3], OH: [7, 3], PA: [8, 3], NJ: [9, 3], CT: [10, 3],
  CA: [1, 4], UT: [2, 4], CO: [3, 4], NE: [4, 4], MO: [5, 4], KY: [6, 4], WV: [7, 4], VA: [8, 4], MD: [9, 4], DE: [10, 4],
  AZ: [2, 5], NM: [3, 5], KS: [4, 5], AR: [5, 5], TN: [6, 5], NC: [7, 5], SC: [8, 5], DC: [9, 5],
  OK: [4, 6], LA: [5, 6], MS: [6, 6], AL: [7, 6], GA: [8, 6],
  HI: [0, 7], TX: [4, 7], FL: [9, 7],
};
const CELL = 20;
const TILE = 18;

/** Lower bounds of the five population steps. */
const STEPS = [0, 1e6, 3e6, 7e6, 15e6];
const STEP_LABELS = ['< 1 M', '1–3 M', '3–7 M', '7–15 M', '≥ 15 M'];
const stepOf = (pop: number) => STEPS.reduce((acc, min, i) => (pop >= min ? i + 1 : acc), 1);

const tiles = data.states.map((s) => {
  const pos = GRID[s.abbr];
  if (!pos) throw new Error(`DemographicsVisual: no tile for ${s.abbr}`);
  return { abbr: s.abbr, x: pos[0] * CELL + 1, y: pos[1] * CELL + 1, step: stepOf(s.population) };
});
const skipped = data.skipped[0]!;
const skipPos = GRID[skipped.abbr]!;
const sx = skipPos[0] * CELL + 1;
const sy = skipPos[1] * CELL + 1;
const c = data.counts;
const n = (v: number) => v.toLocaleString('en-GB');
const top = [...data.states].sort((a, b) => b.population - a.population).slice(0, 4);
const label = `Tile-grid map of the United States shaded by state population as returned by the service: ${c.statesAggregated} rows. Largest: ${top
  .map((s) => `${s.stateName} ${(s.population / 1e6).toFixed(1)} million`)
  .join(', ')}. ${skipped.stateName} is outlined as skipped because its ${skipped.nullPopulation} upstream records have a null population.`;
---

<div class="viz" role="img" aria-label={label}>
  <p class="cap" aria-hidden="true"><span>GET /api/states</span><span>200 · {c.statesAggregated} rows</span></p>

  <div class="body" aria-hidden="true">
    <ol class="flow" role="list">
      <li><b>ArcGIS FeatureServer</b><span>{n(c.featuresFetched)} records · {c.pagesFetched} pages</span></li>
      <li><b>Aggregate by state</b><span>null filter · group · sum</span></li>
      <li><b>PostgreSQL 15</b><span>{c.statesAggregated} rows · one transaction</span></li>
      <li><b>REST API</b><span>2 endpoints · JSON</span></li>
    </ol>
    <div class="mapwrap">
      <svg viewBox="0 0 240 160" preserveAspectRatio="xMidYMid meet" focusable="false">
        <defs>
          <pattern id="dmv-hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line class="hatch" x1="0" y1="0" x2="0" y2="4"></line>
          </pattern>
        </defs>
        {
          tiles.map((t) => (
            <g class={`t s${t.step}`}>
              <rect x={t.x} y={t.y} width={TILE} height={TILE} rx="1.5" />
              <text x={t.x + TILE / 2} y={t.y + TILE / 2}>{t.abbr}</text>
            </g>
          ))
        }
        <g class="t skip">
          <rect x={sx} y={sy} width={TILE} height={TILE} rx="1.5"></rect>
          <text x={sx + TILE / 2} y={sy + TILE / 2}>{skipped.abbr}</text>
        </g>
      </svg>
    </div>
  </div>

  <ul class="legend" role="list" aria-hidden="true">
    {
      STEP_LABELS.map((l, i) => (
        <li>
          <i class={`sw s${i + 1}`} />
          <span class="ll">{l}</span>
        </li>
      ))
    }
    <li class="lskip"><i class="sw skip"></i>{skipped.abbr} skipped (null)</li>
  </ul>
</div>

<style>
  .viz {
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-3) var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-2);
  }
  .cap {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.02em;
    flex-wrap: wrap;
  }
  .cap span:first-child {
    color: var(--text);
  }
  .body {
    display: flex;
    gap: var(--s-5);
    min-height: 0;
  }
  .mapwrap {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Five monochrome steps: one token colour at increasing opacity. */
  .s1 {
    --o: 0.1;
  }
  .s2 {
    --o: 0.22;
  }
  .s3 {
    --o: 0.38;
  }
  .s4 {
    --o: 0.7;
  }
  .s5 {
    --o: 1;
  }
  .t rect {
    fill: var(--text);
    fill-opacity: var(--o);
    stroke: var(--border-strong);
    stroke-width: 0.5;
  }
  .t text {
    display: none;
    font-family: var(--font-mono);
    font-size: 6.6px;
    font-weight: 500;
    text-anchor: middle;
    dominant-baseline: central;
    fill: var(--text);
  }
  .t.s4 text,
  .t.s5 text {
    fill: var(--bg);
  }
  .t.skip rect {
    fill: url(#dmv-hatch);
    fill-opacity: 1;
    stroke: var(--warn);
    stroke-width: 1;
    stroke-dasharray: 2.5 1.5;
  }
  .hatch {
    stroke: var(--warn);
    stroke-width: 0.8;
    opacity: 0.55;
  }
  .t.skip text {
    fill: var(--warn);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 2.5px;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--border);
    white-space: nowrap;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .sw {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--text) calc(var(--o) * 100%), transparent);
  }
  .sw.skip {
    border: 1px dashed var(--warn);
    background: repeating-linear-gradient(45deg, transparent 0 2px, var(--warn) 2px 3px);
  }
  .lskip {
    margin-left: auto;
    color: var(--warn);
  }
  /* Small: keep only the end labels of the scale. */
  .legend li:not(:first-child, :nth-child(5), .lskip) .ll {
    display: none;
  }

  .flow {
    display: none;
    flex: 0 0 13.5rem;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
  }
  .flow li {
    position: relative;
    display: grid;
    gap: 1px;
    padding-left: var(--s-4);
    line-height: 1.4;
  }
  .flow li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--text-2);
    background: var(--bg);
  }
  .flow li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 3px;
    top: calc(0.35em + 9px);
    bottom: calc(-1 * var(--s-3) - 0.35em + 1px);
    width: 1px;
    background: var(--border-strong);
  }
  .flow li:last-child::before {
    background: var(--text);
    border-color: var(--text);
  }
  .flow b {
    font-weight: 500;
    color: var(--text);
  }
  .flow span {
    color: var(--text-3);
  }

  /* Medium: abbreviations and legend appear. */
  @container (min-width: 26rem) {
    .t text {
      display: block;
    }
    .legend {
      gap: var(--s-1) var(--s-4);
    }
    .legend .ll {
      display: inline !important;
    }
  }
  /* Wide: the ingest-to-API flow sits beside the map. */
  @container (min-width: 36rem) {
    .viz {
      padding: var(--s-4) var(--s-5);
      gap: var(--s-3);
    }
    .flow {
      display: flex;
    }
  }
  @container (min-width: 60rem) {
    .flow {
      flex-basis: 19rem;
      gap: var(--s-4);
      font-size: var(--text-xs);
    }
    .flow li:not(:last-child)::after {
      bottom: calc(-1 * var(--s-4) - 0.35em + 1px);
    }
    .t text {
      font-size: 5.4px;
    }
  }
</style>
