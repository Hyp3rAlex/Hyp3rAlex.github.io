---
/**
 * Card / hero visual: a telemetry preview of scenario S10 (speed signal frozen for 3–5 s during a
 * 3 m/s² stop) from the shipped synthetic dataset. Traces, truth window and detection times are
 * computed at build time; the detection markers come from running the monitor port.
 * Lines live in a stretched SVG (non-scaling strokes); all text is HTML so it stays legible at any size.
 * A CSS-only playhead sweeps the record once on the case-study hero and while a card is hovered or
 * focused; without motion the finished state is shown. Nothing animates layout.
 */
import raw from '../../../data/demo/longisafe.json';
import { evaluate, scenarioSignals, type DemoDataset } from '../../../lib/longisafe';

const data = raw as unknown as DemoDataset;
const ID = 'S10';
const sc = data.scenarios.find((s) => s.id === ID)!;
const sig = scenarioSignals(data, ID);
const { rules } = evaluate(sig);
const det = (id: string) => rules.find((r) => r.rule_id === id && r.status === 'FAIL')?.detection_time_s ?? null;
const d3 = det('MON-003');
const d4 = det('MON-004');
const fault = sc.truth.fault;
const T = 10;
const px = (t: number) => (t / T) * 100;
const V = { lo: 0, hi: 27, ticks: [0, 10, 20] };
const A = { lo: -4, hi: 1, ticks: [-3, 0] };
const py = (val: number, r: { lo: number; hi: number }) => 100 - ((val - r.lo) / (r.hi - r.lo)) * 100;
const line = (vals: readonly number[], r: { lo: number; hi: number }, from = 0, to = vals.length, offset = 0) => {
  let d = '';
  for (let i = from; i < to; i++) {
    const t = sig.time_s[i + offset];
    if (t > T) break;
    d += `${d ? 'L' : 'M'}${px(t).toFixed(2)} ${py(vals[i], r).toFixed(2)}`;
  }
  return d;
};
const first = (fault.first_csv_row ?? 2) - 2;
const last = (fault.last_csv_row ?? 2) - 2;
const speed = line(sig.vehicle_speed_mps, V);
// Faulty stretch of the observed speed: the injected samples plus the step back to the true value.
const faulty = line(sig.vehicle_speed_mps, V, first, last + 2);
const accel = line(sig.accel_long_mps2, A);
const clean = fault.clean_values ? line(fault.clean_values, V, 0, fault.clean_values.length, first) : '';
const band = `left:${px(fault.t_start_s)}%;width:${px((fault.t_end_s ?? T) - fault.t_start_s)}%`;
const xt = [0, 2, 4, 6, 8, 10];
const heldSpeed = sig.vehicle_speed_mps[first];
const trueEnd = fault.clean_values?.[fault.clean_values.length - 1] ?? heldSpeed;
const label = `Telemetry plot of synthetic scenario ${ID}: vehicle speed and measured longitudinal acceleration over ${T} seconds of a 3 m/s² stop. The speed signal is frozen at ${heldSpeed.toFixed(1)} m/s between ${fault.t_start_s} and ${fault.t_end_s} seconds while acceleration keeps reading about minus 3 m/s². The coherence monitor MON-003 detects the contradiction at ${d3?.toFixed(2)} seconds and the frozen-signal monitor MON-004 at ${d4?.toFixed(2)} seconds.`;
// The sweep covers 0–10 s in the first 80 % of the animation cycle; each monitor flips when the
// playhead reaches its detection time, so the keyframe positions are derived from the data.
const flip = (name: string, t: number | null) => {
  const at = (((t ?? T) / T) * 80).toFixed(2);
  const before = (Number(at) - 0.05).toFixed(2);
  return `@keyframes lsv-on${name}{0%,${before}%{opacity:0}${at}%,100%{opacity:1}}@keyframes lsv-off${name}{0%,${before}%{opacity:1}${at}%,100%{opacity:0}}`;
};
const keyframes = flip('3', d3) + flip('4', d4);
---

<div class="lsv" role="img" aria-label={label}>
  <style is:inline set:html={keyframes}></style>
  <p class="cap" aria-hidden="true">
    <span class="ttl"><b>{ID}</b> speed signal frozen {fault.t_start_s}–{fault.t_end_s} s</span>
    <span class="tagx">synthetic data</span>
  </p>

  <ul class="chips" role="list" aria-hidden="true">
    <li>
      <span class="k">held at</span>
      <span class="v">{heldSpeed.toFixed(1)} <i>m/s</i></span>
    </li>
    <li class="opt">
      <span class="k">true speed at {fault.t_end_s} s</span>
      <span class="v">{trueEnd.toFixed(1)} <i>m/s</i></span>
    </li>
    <li class="mon m3">
      <span class="k">MON-003<span class="opt"> coherence</span></span>
      <span class="v sw"><span class="pre">watching</span><span class="post">FAIL · {d3?.toFixed(2)} s</span></span>
    </li>
    <li class="mon m4">
      <span class="k">MON-004<span class="opt"> frozen signal</span></span>
      <span class="v sw"><span class="pre">watching</span><span class="post">FAIL · {d4?.toFixed(2)} s</span></span>
    </li>
  </ul>

  <div class="panels" aria-hidden="true">
    <div class="pn pn-v">
      <div class="yax">{V.ticks.map((t) => <span style={`top:${py(t, V)}%`}>{t}</span>)}</div>
      <div class="plot">
        {V.ticks.map((t) => <i class="grid" style={`top:${py(t, V)}%`} />)}
        <i class="band" style={band} />
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <path class="clean" d={clean} />
          <path class="obs" d={speed} />
          <path class="bad" d={faulty} />
        </svg>
        {d3 !== null && <i class="det d3" style={`left:${px(d3)}%`} />}
        {d4 !== null && <i class="det d4" style={`left:${px(d4)}%`} />}
        <i class="ph" />
        <span class="unit">speed · m/s</span>
        <span class="truth" style={`left:${px(fault.t_start_s)}%`}>fault truth</span>
      </div>
    </div>
    <div class="pn pn-a">
      <div class="yax">{A.ticks.map((t) => <span style={`top:${py(t, A)}%`}>{t}</span>)}</div>
      <div class="plot">
        {A.ticks.map((t) => <i class="grid" style={`top:${py(t, A)}%`} />)}
        <i class="band" style={band} />
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <path class="obs obs--a" d={accel} />
        </svg>
        {d3 !== null && <i class="det d3" style={`left:${px(d3)}%`} />}
        {d4 !== null && <i class="det d4" style={`left:${px(d4)}%`} />}
        <i class="ph" />
        <span class="unit">measured accel · m/s²</span>
      </div>
    </div>
    <div class="xax">
      <div class="xt">{xt.map((t) => <span style={`left:${px(t)}%`}>{t}</span>)}<em>s</em></div>
    </div>
  </div>

  <ul class="legend" role="list" aria-hidden="true">
    <li><i class="lk lk-obs"></i>observed</li>
    <li><i class="lk lk-bad"></i>faulty stretch</li>
    <li><i class="lk lk-clean"></i>un-faulted reference</li>
    <li><i class="lk lk-band"></i>truth window, hidden from monitors</li>
    <li><i class="lk lk-det"></i>detection</li>
  </ul>
</div>

<style>
  .lsv {
    --dur: 4s;
    container-type: size;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-4) var(--s-5) var(--s-3) var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-2);
    line-height: 1.3;
  }
  .cap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--s-3);
    letter-spacing: 0.02em;
  }
  .ttl {
    color: var(--text);
  }
  .ttl b {
    font-weight: 500;
    padding: 1px 5px;
    margin-right: 6px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-1);
  }
  .tagx {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--warn);
  }

  /* Readout chips */
  .chips {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }
  .chips li {
    display: grid;
    gap: 1px;
    padding: 5px 8px;
    border-left: 1px solid var(--border);
    min-width: 0;
    align-content: start;
  }
  .chips li:first-child {
    border-left: 0;
  }
  .chips .k {
    color: var(--text-3);
    letter-spacing: 0.04em;
  }
  .chips .v {
    font-size: var(--text-sm);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .chips .v i {
    font-style: normal;
    font-size: var(--text-2xs);
    color: var(--text-3);
  }
  .sw {
    display: grid;
  }
  .sw > span {
    grid-area: 1 / 1;
  }
  .sw .pre {
    opacity: 0;
    color: var(--text-2);
  }
  .sw .post {
    color: var(--fail);
  }

  .panels {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: 3fr 2fr auto;
    gap: 7px;
  }
  .pn {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    min-height: 0;
  }
  .yax,
  .plot {
    position: relative;
  }
  .yax span {
    position: absolute;
    right: 6px;
    transform: translateY(-50%);
    color: var(--text-3);
  }
  .plot {
    border-left: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .plot path {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .obs {
    stroke: var(--text);
    stroke-width: 1.75;
  }
  .obs--a {
    stroke-width: 1.1;
  }
  .bad {
    stroke: var(--fail);
    stroke-width: 2.5;
  }
  .clean {
    stroke: var(--ok);
    stroke-width: 1.5;
    stroke-dasharray: 2 4;
  }
  .grid {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px solid var(--grid-line);
  }
  .band {
    position: absolute;
    top: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--warn) 13%, transparent);
    border-inline: 1px dashed var(--warn);
  }
  .det {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--fail);
  }
  .det::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -5px;
    border: 4.5px solid transparent;
    border-top: 7px solid var(--fail);
    border-bottom: 0;
  }
  /* Playhead: full-width overlay moved with a transform, so nothing reflows. Hidden unless animating. */
  .ph {
    position: absolute;
    inset: 0;
    border-left: 1px solid var(--text);
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }
  .pn-v .ph::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    width: 7px;
    height: 7px;
    background: var(--text);
    border-radius: 1px;
  }
  .unit {
    position: absolute;
    padding: 0 4px;
    color: var(--text-3);
    background: var(--bg);
    white-space: nowrap;
  }
  .pn-v .unit {
    left: 6px;
    bottom: 4px;
  }
  .pn-a .unit {
    top: 42%;
    right: 10%;
  }
  .truth {
    position: absolute;
    bottom: 3px;
    margin-left: 5px;
    color: var(--warn);
    white-space: nowrap;
  }
  .xax {
    padding-left: 1.6rem;
  }
  .xt {
    position: relative;
    height: 1.2em;
    color: var(--text-3);
  }
  .xt span {
    position: absolute;
    transform: translateX(-50%);
  }
  .xt span:first-child {
    transform: none;
  }
  .xt span:last-of-type {
    transform: translateX(-190%);
  }
  .xt em {
    position: absolute;
    right: 0;
    font-style: normal;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--s-4);
    padding-left: 1.6rem;
    color: var(--text-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .lk {
    display: inline-block;
    width: 16px;
    height: 0;
    border-top: 2px solid var(--text);
  }
  .lk-bad {
    border-top: 3px solid var(--fail);
  }
  .lk-clean {
    border-top: 2px dotted var(--ok);
  }
  .lk-band {
    height: 9px;
    border: 0;
    border-inline: 1px dashed var(--warn);
    background: color-mix(in srgb, var(--warn) 14%, transparent);
  }
  .lk-det {
    width: 0;
    border: 4.5px solid transparent;
    border-top: 7px solid var(--fail);
    border-bottom: 0;
  }

  /* ---- Size adaptation ---- */
  @container (max-width: 34rem) {
    .legend,
    .truth,
    .chips .opt {
      display: none;
    }
    .chips {
      grid-template-columns: 0.8fr 1.2fr 1.2fr;
    }
    .sw .post,
    .sw .pre {
      white-space: normal;
    }
    .chips .k {
      font-size: 0.625rem;
      letter-spacing: 0;
    }
    .chips .v {
      font-size: var(--text-xs);
    }
    .chips li {
      padding: 4px 6px;
    }
  }
  /* Small index cards: two chips only, so no value is ever cut mid-number. */
  @container (max-width: 26rem) {
    .chips .m4 {
      display: none;
    }
    .chips {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  @container (max-width: 22rem) {
    .tagx {
      display: none;
    }
  }
  @container (max-height: 17rem) {
    .legend {
      display: none;
    }
  }
  @container (max-height: 13rem) {
    .chips {
      display: none;
    }
  }
  @container (min-width: 56rem) {
    .lsv {
      padding: var(--s-5) var(--s-7) var(--s-4) var(--s-6);
      gap: var(--s-3);
    }
  }

  /* ---- Motion: one sweep on the hero, looping while a card is hovered or focused ---- */
  /* WCAG 2.2.2: nothing moves for more than 5 s without user control. The hero plays one pass
     (0.4 s delay + 4 s); a focused card plays one pass; only a hovered card loops, and stops on leave. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.case-visual) .ph,
    :global(.card:focus-within) .ph {
      animation: lsv-sweep var(--dur) linear var(--delay, 0s) 1 both;
    }
    :global(.case-visual) :is(.d3, .m3 .post),
    :global(.card:focus-within) :is(.d3, .m3 .post) {
      animation: lsv-on3 var(--dur) linear var(--delay, 0s) 1 both;
    }
    :global(.case-visual) :is(.d4, .m4 .post),
    :global(.card:focus-within) :is(.d4, .m4 .post) {
      animation: lsv-on4 var(--dur) linear var(--delay, 0s) 1 both;
    }
    :global(.case-visual) .m3 .pre,
    :global(.card:focus-within) .m3 .pre {
      animation: lsv-off3 var(--dur) linear var(--delay, 0s) 1 both;
    }
    :global(.case-visual) .m4 .pre,
    :global(.card:focus-within) .m4 .pre {
      animation: lsv-off4 var(--dur) linear var(--delay, 0s) 1 both;
    }
    :global(.case-visual) .lsv {
      --delay: 0.4s;
    }
    :global(.card:hover) .ph {
      animation: lsv-sweep var(--dur) linear infinite;
    }
    :global(.card:hover) :is(.d3, .m3 .post) {
      animation: lsv-on3 var(--dur) linear infinite;
    }
    :global(.card:hover) :is(.d4, .m4 .post) {
      animation: lsv-on4 var(--dur) linear infinite;
    }
    :global(.card:hover) .m3 .pre {
      animation: lsv-off3 var(--dur) linear infinite;
    }
    :global(.card:hover) .m4 .pre {
      animation: lsv-off4 var(--dur) linear infinite;
    }
  }
  /* The sweep covers 0–10 s in the first 80 % of the cycle, then rests on the finished state. */
  @keyframes lsv-sweep {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    80% {
      transform: translateX(100%);
      opacity: 1;
    }
    86%,
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }
</style>
