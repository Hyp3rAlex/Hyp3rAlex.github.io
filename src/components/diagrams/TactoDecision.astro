---
/**
 * Decision path of the submitted chain, `--agent better`:
 * EvidenceAgent(HealthScope(GuardedAgent(BetterAgent())))  (agent/arena_kit/cli.py:126-127 @ 700cf95).
 * Guard branches follow guard.py:128-162, 186-209, 271-298.
 */
const rows = [
  {
    y: 128,
    h: 98,
    when: 'IF THE DELEGATE ACCEPTS',
    title: 'Verify the accept',
    lines: ['standing sheet id · must-haves hold ·', 'cost below the alternative;', 'unmoved round-1 quote: counter first'],
  },
  {
    y: 234,
    h: 98,
    when: 'IF IT SENDS TERM SHEETS OR TEXT',
    title: 'Force must-haves into every sheet',
    lines: ['boundary option, re-forced after snap;', 'last message is never a price push;', 'text-only message: passes'],
  },
  {
    y: 340,
    h: 98,
    when: 'ON WALK-AWAY, CRASH OR NO DECISION',
    title: 'Keep going',
    lines: ['accept a safe standing sheet, else', 'counter at their price (max 2 / thread);', 'walk only if nothing beats the alternative'],
  },
];
const mrows = [
  { y: 296, h: 106, when: rows[0]!.when, title: rows[0]!.title, lines: rows[0]!.lines },
  { y: 410, h: 106, when: rows[1]!.when, title: rows[1]!.title, lines: rows[1]!.lines },
  { y: 524, h: 106, when: rows[2]!.when, title: rows[2]!.title, lines: ['accept a safe standing sheet, else', 'counter at their price (max 2/thread);', 'walk only if nothing beats alternative'] },
];
---

<div class="dg-desktop has-mobile">
<svg
  class="tq-dg"
  viewBox="0 0 800 546"
  role="img"
  aria-labelledby="tq-dg-t tq-dg-d"
>
  <title id="tq-dg-t">Decision path of the submitted agent chain</title>
  <desc id="tq-dg-d">
    The arena sends the case and all supplier threads. BetterAgent, written by a teammate, decides. GuardedAgent, Alexander's component, checks that decision: an
    accept is verified, term sheets get every must-have forced in, and a walk-away, crash or empty decision is replaced by accepting a safe standing sheet or by a
    counter at the supplier's own price. HealthScope wraps both and sets the supplier-health estimate. EvidenceAgent then rewrites only the e-mail text and the
    message goes back to the arena.
  </desc>
  <defs>
    <marker id="tq-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="dg-head" d="M0 0 8 4 0 8z"></path>
    </marker>
  </defs>

  <!-- HealthScope scope -->
  <rect class="dg-box dg-box--ext" x="136" y="30" width="514" height="432" rx="4"></rect>
  <text class="dg-title" x="150" y="54">HealthScope</text>
  <text class="dg-sub" x="150" y="72">sets the supplier-health estimate and close veto for the calls inside</text>

  <!-- Arena -->
  <rect class="dg-box dg-box--ext" x="4" y="150" width="118" height="100" rx="4"></rect>
  <text class="dg-title" x="14" y="176">Arena</text>
  <text class="dg-sub" x="14" y="196">sends case +</text>
  <text class="dg-sub" x="14" y="212">all threads;</text>
  <text class="dg-sub" x="14" y="228">≤ 10 msgs each</text>

  <!-- BetterAgent -->
  <rect class="dg-box" x="150" y="140" width="152" height="120" rx="4"></rect>
  <text class="dg-title" x="162" y="164">BetterAgent</text>
  <text class="dg-sub" x="162" y="184">decision logic</text>
  <text class="dg-sub" x="162" y="200">late accept, price</text>
  <text class="dg-sub" x="162" y="216">step, accept rule</text>
  <text class="dg-sub" x="162" y="244">better_agent.py</text>
  <text class="dg-sub" x="150" y="296">also imports</text>
  <text class="dg-sub" x="150" y="312">satisfy_must_haves()</text>

  <!-- GuardedAgent -->
  <rect class="dg-box dg-box--hi" x="330" y="92" width="306" height="356" rx="4"></rect>
  <text class="dg-title" x="342" y="116">GuardedAgent</text>
  <text class="dg-sub" x="452" y="116">guard.py</text>
  <rect class="tq-tag" x="594" y="102" width="30" height="18" rx="2"></rect>
  <text class="tq-tagt" x="609" y="115" text-anchor="middle">AY</text>
  {
    rows.map((r) => (
      <g>
        <rect class="dg-box tq-row" x="342" y={r.y} width="282" height={r.h} rx="3" />
        <text class="dg-sub tq-when" x="352" y={r.y + 18}>
          {r.when}
        </text>
        <text class="dg-title tq-rt" x="352" y={r.y + 36}>
          {r.title}
        </text>
        {r.lines.map((l, i) => (
          <text class="dg-sub" x="352" y={r.y + 54 + i * 15}>
            {l}
          </text>
        ))}
      </g>
    ))
  }

  <!-- EvidenceAgent -->
  <rect class="dg-box" x="668" y="140" width="124" height="120" rx="4"></rect>
  <text class="dg-title" x="678" y="164">EvidenceAgent</text>
  <text class="dg-sub" x="678" y="184">rewrites e-mail</text>
  <text class="dg-sub" x="678" y="200">text, adds data</text>
  <text class="dg-sub" x="678" y="216">citations; never</text>
  <text class="dg-sub" x="678" y="232">edits term sheets</text>

  <!-- flows -->
  <path class="dg-flow" d="M122 190H148" marker-end="url(#tq-arrow)"></path>
  <path class="dg-flow dg-flow--beam" d="M302 190H328" marker-end="url(#tq-arrow)"></path>
  <path class="dg-flow dg-flow--dash" d="M330 280H226V262" marker-end="url(#tq-arrow)"></path>
  <path class="dg-flow dg-flow--beam" d="M636 190H666" marker-end="url(#tq-arrow)"></path>
  <path class="dg-flow" d="M730 260V500H63V252" marker-end="url(#tq-arrow)"></path>
  <text class="dg-sub" x="400" y="490" text-anchor="middle">one message per turn: 1–3 term sheets, an accept, or a walk-away</text>

  <!-- legend -->
  <rect class="tq-tag" x="10" y="522" width="30" height="18" rx="2"></rect>
  <text class="tq-tagt" x="25" y="535" text-anchor="middle">AY</text>
  <text class="dg-sub" x="48" y="535">my component</text>
  <rect class="dg-box" x="160" y="522" width="26" height="18" rx="2"></rect>
  <text class="dg-sub" x="194" y="535">teammates’ code</text>
  <rect class="dg-box dg-box--ext" x="322" y="522" width="26" height="18" rx="2"></rect>
  <text class="dg-sub" x="356" y="535">external / wrapper scope</text>
  <path class="dg-flow dg-flow--dash" d="M540 531H566"></path>
  <text class="dg-sub" x="574" y="535">function import</text>
</svg>
</div>
<div class="dg-mobile">
  <svg class="tq-dg tq-m" viewBox="0 0 360 907" role="img" aria-labelledby="tq-dgm-t tq-dgm-d">
    <title id="tq-dgm-t">Decision path of the submitted agent chain</title>
    <desc id="tq-dgm-d">
      Top to bottom: the arena sends the case and all supplier threads. BetterAgent, written by a teammate, decides. GuardedAgent, Alexander's component, checks
      that decision: an accept is verified, term sheets get every must-have forced in, and a walk-away, crash or empty decision is replaced by accepting a safe
      standing sheet or by a counter at the supplier's own price. HealthScope wraps both. EvidenceAgent rewrites only the e-mail text, and one message goes back
      to the arena.
    </desc>
    <defs>
      <marker id="tq-arrow-m" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path class="dg-head" d="M0 0 8 4 0 8z"></path>
      </marker>
    </defs>

    <rect class="dg-box dg-box--ext" x="16" y="6" width="328" height="60" rx="4"></rect>
    <text class="dg-title" x="28" y="29">Arena</text>
    <text class="dg-sub" x="28" y="50">sends case + all threads; ≤ 10 msgs each</text>
    <path class="dg-flow" d="M320 66V138" marker-end="url(#tq-arrow-m)"></path>

    <rect class="dg-box dg-box--ext" x="4" y="88" width="352" height="565" rx="4"></rect>
    <text class="dg-title" x="16" y="111">HealthScope</text>
    <text class="dg-sub" x="16" y="129">supplier-health estimate, close veto</text>

    <rect class="dg-box" x="16" y="140" width="328" height="96" rx="4"></rect>
    <text class="dg-title" x="28" y="163">BetterAgent</text>
    <text class="dg-sub" x="200" y="163">better_agent.py</text>
    <text class="dg-sub" x="28" y="184">decision logic: late accept, price step,</text>
    <text class="dg-sub" x="28" y="201">own accept rule</text>
    <text class="dg-sub" x="28" y="223">also imports satisfy_must_haves()</text>
    <path class="dg-flow" d="M180 236V256" marker-end="url(#tq-arrow-m)"></path>

    <rect class="dg-box dg-box--hi" x="16" y="258" width="328" height="383" rx="4"></rect>
    <text class="dg-title" x="28" y="282">GuardedAgent</text>
    <text class="dg-sub" x="150" y="282">guard.py</text>
    <rect class="tq-tag" x="302" y="268" width="30" height="18" rx="2"></rect>
    <text class="tq-tagt" x="317" y="281" text-anchor="middle">AY</text>
    {
      mrows.map((r) => (
        <g>
          <rect class="dg-box tq-row" x="26" y={r.y} width="308" height={r.h} rx="3" />
          <text class="dg-sub tq-when" x="36" y={r.y + 21}>
            {r.when}
          </text>
          <text class="dg-title" x="36" y={r.y + 41}>
            {r.title}
          </text>
          {r.lines.map((l, i) => (
            <text class="dg-sub" x="36" y={r.y + 61 + i * 17}>
              {l}
            </text>
          ))}
        </g>
      ))
    }
    <path class="dg-flow" d="M180 641V672" marker-end="url(#tq-arrow-m)"></path>

    <rect class="dg-box" x="16" y="674" width="328" height="78" rx="4"></rect>
    <text class="dg-title" x="28" y="697">EvidenceAgent</text>
    <text class="dg-sub" x="28" y="718">rewrites e-mail text, adds citations;</text>
    <text class="dg-sub" x="28" y="735">never edits term sheets</text>
    <path class="dg-flow" d="M180 752V774" marker-end="url(#tq-arrow-m)"></path>

    <rect class="dg-box dg-box--ext" x="16" y="776" width="328" height="60" rx="4"></rect>
    <text class="dg-title" x="28" y="799">One message back to the arena</text>
    <text class="dg-sub" x="28" y="820">1–3 term sheets, an accept or a walk-away</text>

    <rect class="tq-tag" x="16" y="855" width="30" height="18" rx="2"></rect>
    <text class="tq-tagt" x="31" y="868" text-anchor="middle">AY</text>
    <text class="dg-sub" x="54" y="868">my component</text>
    <rect class="dg-box" x="16" y="881" width="26" height="18" rx="2"></rect>
    <text class="dg-sub" x="50" y="894">teammates’ code</text>
    <rect class="dg-box dg-box--ext" x="184" y="881" width="26" height="18" rx="2"></rect>
    <text class="dg-sub" x="218" y="894">external / scope</text>
  </svg>
</div>


<style>
  .tq-dg {
    display: block;
  }
  .tq-row {
    fill: var(--bg);
    stroke: var(--border);
  }
  .tq-when {
    letter-spacing: 0.04em;
  }
  .tq-rt {
    font-size: 12.5px;
  }
  .tq-tag {
    fill: var(--text);
  }
  .tq-m .dg-sub {
    font-size: 12px;
  }
  .tq-m .dg-title {
    font-size: 14px;
  }
  .tq-tagt {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    fill: var(--bg);
  }
</style>
