---
/** Captioned figure for case studies. `n` is the figure number; `source` states provenance (file, revision, or "synthetic"). */
interface Props {
  n?: string | number;
  caption: string;
  source?: string;
  wide?: boolean;
  scroll?: boolean;
}
const { n, caption, source, wide = false, scroll = false } = Astro.props;
---

<figure class:list={['fig', { full: wide }]}>
  <div class:list={['fig-body', 'corner-marks', { 'fig-scroll': scroll }]} tabindex={scroll ? 0 : undefined} role={scroll ? 'group' : undefined} aria-label={scroll ? caption : undefined}>
    <slot />
  </div>
  <figcaption>
    {n !== undefined && <span class="mono">Fig. {n}</span>}
    <span>{caption}</span>
    {source && <span class="fig-src mono">{source}</span>}
    {scroll && <span class="fig-hint mono" aria-hidden="true">↔ Scroll sideways to see the whole diagram</span>}
  </figcaption>
</figure>

<style>
  .fig {
    margin-block: var(--s-6);
  }
  .fig-body {
    border: 1px solid var(--border);
    background: var(--bg);
    padding: var(--s-4);
  }
  .fig-body :global(svg) {
    width: 100%;
    height: auto;
  }
  .fig-scroll {
    overflow-x: auto;
  }
  .fig-scroll :global(svg) {
    min-width: 40rem;
  }
  .fig-hint {
    flex-basis: 100%;
    color: var(--text-2) !important;
    text-transform: none;
    letter-spacing: 0.01em;
  }
  @media (min-width: 48em) {
    .fig-hint {
      display: none;
    }
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-3);
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.5;
  }
  figcaption .mono {
    color: var(--text);
    padding-top: 0.15em;
  }
  .fig-src {
    flex-basis: 100%;
    color: var(--text-3) !important;
    text-transform: none;
    letter-spacing: 0.01em;
  }
</style>
