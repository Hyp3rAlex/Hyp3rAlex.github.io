---
/**
 * CV actions for one specialization: two direct downloads (English, German) with document metadata,
 * and a quiet link for requesting a tailored version by email. If the documents are not present in
 * this build, the email request is the honest fallback.
 */
import { cvButtonLabel, cvFocusLabel, type CvFocus } from '../../data/cv';
import { cvMeta, loadCvs } from '../../lib/cv';
import { person } from '../../data/profile';

interface Props {
  focus: CvFocus;
}
const { focus } = Astro.props;
const label = cvFocusLabel[focus];
const files = loadCvs().filter((f) => f.focus === focus);
const en = files.find((f) => f.lang === 'en');
const de = files.find((f) => f.lang === 'de');
const mailto = `mailto:${person.email}?subject=${encodeURIComponent(`CV request — ${label}`)}`;
---

<div class="cv">
  {
    en || de ? (
      <>
        <div class="dl">
          {en && (
            <a class="btn btn--primary" href={en.href} download={en.file} hreflang="en" type="application/pdf" aria-label={`Download CV, ${label}, English, PDF`}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 1.5v8M3.5 6.5 7 10l3.5-3.5M2 12.5h10" stroke-linecap="square" /></svg>
              {cvButtonLabel.en}
            </a>
          )}
          {de && (
            <a class="btn" href={de.href} download={de.file} hreflang="de" lang="de" type="application/pdf" aria-label={`Lebenslauf herunterladen, ${label}, Deutsch, PDF`}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 1.5v8M3.5 6.5 7 10l3.5-3.5M2 12.5h10" stroke-linecap="square" /></svg>
              {cvButtonLabel.de}
            </a>
          )}
        </div>
        <p class="meta mono">{cvMeta(files)}</p>
        <p class="alt"><a href={mailto}>Request a tailored CV by email</a></p>
      </>
    ) : (
      <>
        <a class="btn btn--primary" href={mailto}>Request CV by email</a>
        <p class="alt">English or German, tailored to this specialization.</p>
      </>
    )
  }
</div>

<style>
  .cv {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .dl .btn {
    padding-inline: var(--s-4);
    white-space: nowrap;
  }
  .meta {
    font-size: var(--text-2xs);
    color: var(--text-3);
  }
  .alt {
    font-size: var(--text-sm);
    color: var(--text-3);
  }
  .alt a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-2);
  }
  .alt a:hover {
    color: var(--text);
  }
  @media (max-width: 26em) {
    .dl {
      display: grid;
      width: 100%;
    }
    .cv {
      justify-items: stretch;
    }
  }
</style>
